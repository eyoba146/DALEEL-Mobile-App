generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserType {
  diaspora
  foreign_resident
}

enum Language {
  en
  am
  om
  ar
}

model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String
  userType     UserType
  country      String
  language     Language @default(en)
  isAdmin      Boolean  @default(false)
  isVerified   Boolean  @default(false)
  avatarUrl    String?
  phone        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  favorites           Favorite[]
  emailVerifications  EmailVerification[]
  passwordResets      PasswordReset[]
  serviceInquiries    ServiceInquiry[]
  investmentInquiries InvestmentInquiry[]
  eventRsvps          EventRsvp[]
  productOrderInquiries ProductOrderInquiry[]
  notifications       Notification[]
  notificationPreference NotificationPreference?
}

model Destination {
  id              String   @id @default(uuid())
  name            String
  region          String
  blurb           String
  image           String
  description     String?
  bestTimeToVisit String?
  elevation       String?
  unescoStatus    Boolean  @default(false)
  highlights      String?
  gettingThere    String?
  rating          Float    @default(4.9)
  createdAt       DateTime @default(now())
}

model Service {
  id             String   @id @default(uuid())
  name           String
  category       String
  location       String
  verified       Boolean  @default(false)
  blurb          String
  image          String
  description    String?
  phone          String?
  whatsapp       String?
  email          String?
  address        String?
  rating         Float    @default(4.9)
  reviewCount    Int      @default(0)
  operatingHours String?
  features       String?
  createdAt      DateTime @default(now())

  inquiries      ServiceInquiry[]
}

model ServiceInquiry {
  id              String   @id @default(uuid())
  serviceId       String
  userId          String?
  fullName        String
  contactEmail    String
  contactPhone    String?
  contactWhatsapp String?
  timeframe       String?
  message         String
  status          String   @default("pending")
  createdAt       DateTime @default(now())

  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  user    User?   @relation(fields: [userId], references: [id], onDelete: SetNull)
}

model EventItem {
  id          String      @id @default(uuid())
  title       String
  date        DateTime
  time        String?
  city        String
  venue       String?
  category    String
  price       String?     @default("Free")
  organizer   String?
  blurb       String?
  description String?
  agenda      String?
  capacity    Int?
  verified    Boolean     @default(true)
  image       String
  createdAt   DateTime    @default(now())

  rsvps       EventRsvp[]
}

model EventRsvp {
  id           String    @id @default(uuid())
  eventId      String
  userId       String?
  fullName     String
  email        String
  phone        String?
  ticketsCount Int       @default(1)
  notes        String?
  status       String    @default("confirmed")
  createdAt    DateTime  @default(now())

  event        EventItem @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user         User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
}

enum FavoriteType {
  destination
  service
  event
  investment
  product
}

model InvestmentOpportunity {
  id              String   @id @default(uuid())
  title           String
  sector          String
  location        String
  minInvestment   Float
  currency        String   @default("USD")
  expectedReturn  String?
  investmentModel String?
  timeline        String?
  verified        Boolean  @default(true)
  blurb           String
  image           String
  description     String?
  highlights      String?
  incentives      String?
  contactEmail    String?
  contactPhone    String?
  status          String   @default("open")
  createdAt       DateTime @default(now())

  inquiries       InvestmentInquiry[]
}

model InvestmentInquiry {
  id               String   @id @default(uuid())
  opportunityId    String
  userId           String?
  fullName         String
  contactEmail     String
  contactPhone     String?
  contactWhatsapp  String?
  investmentBudget String?
  timeframe        String?
  message          String
  status           String   @default("pending")
  createdAt        DateTime @default(now())

  opportunity InvestmentOpportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  user        User?                 @relation(fields: [userId], references: [id], onDelete: SetNull)
}

model Favorite {
  id         String       @id @default(uuid())
  userId     String
  itemType   FavoriteType
  itemId     String
  createdAt  DateTime     @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, itemType, itemId])
}

model EmailVerification {
  id        String   @id @default(uuid())
  userId    String
  email     String
  code      String
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())
  
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PasswordReset {
  id        String   @id @default(uuid())
  userId    String
  email     String
  code      String
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())
  
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Product {
  id             String                @id @default(uuid())
  title          String
  price          Float
  currency       String                @default("ETB")
  category       String
  sellerName     String
  sellerVerified Boolean               @default(true)
  sellerLocation String
  sellerPhone    String?
  sellerWhatsapp String?
  image          String
  images         String?
  blurb          String
  description    String?
  materials      String?
  origin         String?
  inStock        Boolean               @default(true)
  status         String                @default("active")
  createdAt      DateTime              @default(now())

  inquiries      ProductOrderInquiry[]
}

model ProductOrderInquiry {
  id              String   @id @default(uuid())
  productId       String
  userId          String?
  fullName        String
  email           String
  phone           String?
  whatsapp        String?
  quantity        Int      @default(1)
  deliveryAddress String
  notes           String?
  status          String   @default("pending")
  createdAt       DateTime @default(now())

  product         Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  user            User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
}

model Notification {
  id        String   @id @default(uuid())
  userId    String?
  title     String
  message   String
  type      String   @default("system") // order, event, investment, system, service
  actionUrl String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model NotificationPreference {
  id            String   @id @default(uuid())
  userId        String   @unique
  orders        Boolean  @default(true)
  events        Boolean  @default(true)
  investments   Boolean  @default(true)
  announcements Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}
